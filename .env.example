# Variables de deploy a Hostinger — plantilla SIN valores reales.
#
# Este archivo SÍ se commitea. NUNCA pongas aquí valores reales de tu hosting.
# Para usarlo en local:
#
#     cp .env.example .env
#
# y rellena los valores. El archivo `.env` está ignorado por git (.gitignore).
#
# En el deploy automático estas variables no se leen de aquí: viven como
# secretos del repositorio en GitHub → Settings → Secrets and variables → Actions,
# con exactamente estos nombres. Ver docs/despliegue-hostinger.md.

# Host/IP del hosting (obligatorio).
SFTP_HOST=

# Puerto SSH (opcional; muchos hostings no usan el 22).
SFTP_PORT=

# Usuario SSH del hosting (obligatorio).
SFTP_USERNAME=

# Clave privada de deploy: RSA en formato PEM (obligatorio).
# Formato multilínea -> en GitHub se pega tal cual; en un .env local conviene
# usar comillas dobles y \n, o exportarla aparte antes de lanzar el deploy.
# Marca de formato esperada: "-----BEGIN RSA PRIVATE KEY-----".
SFTP_SSH_KEY=

# Ruta absoluta de la carpeta destino en el hosting (obligatorio).
# Debe EXISTIR: el deploy usa sftp_only y no crea directorios.
SFTP_TARGET_DIR=
