---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

import type { Lang } from '../i18n/content'

export interface Props {
  title: string
  description?: string
  /** Idioma del documento. Determina `<html lang>` y `og:locale`. */
  lang?: Lang
  /** Ruta canónica con prefijo de sitio, p. ej. `/blog/omarchy`. */
  path?: string
  /** Imagen social absoluta o relativa a `public/`. */
  image?: string
  ogType?: 'website' | 'article'
  publishedTime?: Date
  /** Pares hreflang ya resueltos (ver `postAlternates`). */
  alternates?: { lang: string; href: string }[]
}

const {
  title,
  description,
  lang = 'es',
  path,
  image = '/img/og-default.png',
  ogType = 'website',
  publishedTime,
  alternates = [],
} = Astro.props

const site = Astro.site ?? new URL('https://teapartydev.com')
const canonical = new URL(path ?? Astro.url.pathname, site).href
const ogImage = new URL(image, site).href
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES'
const siteName = 'Teapartydev'
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? title} />
    <meta name="author" content="Adal Michael García" />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description ?? title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description ?? title} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="stylesheet" href="https://www.nerdfonts.com/assets/css/webfont.css" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/img/icon-512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/img/icon-192.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#fabd2f" />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme')
          const theme =
            saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          document.documentElement.setAttribute('data-theme', theme)
        } catch {}
      })()
    </script>
  </head>
  <body class="min-h-screen flex flex-col pt-16">
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
      <symbol id="sun" viewBox="0 0 16 16">
        <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/>
      </symbol>
      <symbol id="moon" viewBox="0 0 16 16">
        <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/>
      </symbol>
    </svg>

    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const themeToggle = document.querySelector('.theme-toggle')
      const themeIcon = document.querySelector('#themeIcon')
      const html = document.documentElement

      function updateIcon(theme: string) {
        if (!themeIcon) return
        themeIcon.setAttribute('href', theme === 'dark' ? '#sun' : '#moon')
      }

      updateIcon(html.getAttribute('data-theme') ?? 'dark')

      themeToggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme')
        const next = current === 'dark' ? 'light' : 'dark'
        html.setAttribute('data-theme', next)
        try {
          localStorage.setItem('theme', next)
        } catch {}
        updateIcon(next)
      })
    </script>
  </body>
</html>
