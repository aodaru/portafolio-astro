---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { getAlternateUrls } from '../i18n/utils'
import { resolveOgImagePath } from '../utils/images'

import type { Lang } from '../i18n/content'

export interface Props {
  title: string
  description?: string
  /** Idioma del documento. Determina `<html lang>` y `og:locale`. */
  lang?: Lang
  /** Imagen social: ruta pública histórica o absoluta. */
  image?: string
  type?: 'website' | 'article'
  publishedDate?: Date
  /** Ruta canónica con prefijo de sitio, p. ej. `/blog/omarchy`. */
  path?: string
  /** Evita la indexación de la página (p. ej. 404). */
  noindex?: boolean
  /** Imagen crítica de la página (elemento LCP) a precargar con prioridad alta. */
  preloadImage?: string
  /**
   * Pares hreflang ya resueltos (ver `postAlternates`): solo los idiomas que
   * realmente tienen versión. Si se omite, se emiten es/en/x-default.
   */
  alternates?: { lang: string; href: string }[]
}

const {
  title,
  description,
  lang = 'es',
  image,
  type = 'website',
  publishedDate,
  path,
  noindex = false,
  preloadImage,
  alternates,
} = Astro.props

const site = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '')
const metaDescription = description ?? title
const siteName = 'Teapartydev'
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`

// Canonical: la ruta real sirve para casi todo; `path` permite fijarla a mano
// (los posts usan rutas limpias sin prefijo de idioma).
const canonical = path
  ? new URL(path, `${site}/`).href
  : `${site}${Astro.url.pathname}`

const ogLocale = lang === 'es' ? 'es_ES' : 'en_US'
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_ES'

// og:image siempre absoluta: variante WebP optimizada de `src/assets/` o ruta pública
const ogImagePath = await resolveOgImagePath(image)
const ogImage = ogImagePath.startsWith('http') ? ogImagePath : `${site}${ogImagePath}`

// hreflang: condicional si la página aporta sus pares, es/en completo si no.
const defaultAlternates = getAlternateUrls(Astro.url)
const hrefEs = `${site}${defaultAlternates.es}`
const hrefEn = `${site}${defaultAlternates.en}`
const hreflangLinks =
  alternates && alternates.length > 0
    ? alternates.map((alt) => ({
        lang: alt.lang,
        href: alt.href.startsWith('http') ? alt.href : `${site}${alt.href}`,
      }))
    : [
        { lang: 'es', href: hrefEs },
        { lang: 'en', href: hrefEn },
        { lang: 'x-default', href: hrefEs },
      ]

// Autodiscovery RSS del idioma actual
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml'
const rssTitle = lang === 'en' ? 'Blog — Teapartydev (EN)' : 'Blog — Teapartydev (ES)'
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content="Adal Michael García" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {hreflangLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/img/icon-512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/img/icon-192.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#fabd2f" />
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href={new URL(rssHref, `${site}/`).toString()} />
    {/* Fase 7/9 perf: preload solo de la fuente del camino crítico (Mononoki
      * Regular 400, texto base/FCP) y de la imagen LCP de la página, que cada
      * página declara vía `preloadImage` (en el inicio, el poster del hero).
      * No precargar Bold/MesloLG/NerdFonts: coste de preload injustificado;
      * van con font-display: swap. */}
    <link rel="preload" href="/fonts/Mononoki-Regular.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
    <title>{fullTitle}</title>
    {/* Fase 9: View Transitions. Astro reemplaza los atributos de <html> en cada
      * navegación, así que el tema debe reaplicarse: `data-astro-rerun` fuerza
      * la reejecución de este script inline tras cada swap. */}
    <ClientRouter />
    <script is:inline data-astro-rerun>
      (function () {
        try {
          const saved = localStorage.getItem('theme')
          const theme =
            saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          document.documentElement.setAttribute('data-theme', theme)
        } catch {}
      })()
    </script>
  </head>
  <body class="min-h-screen flex flex-col pt-16">
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
      <symbol id="sun" viewBox="0 0 16 16">
        <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2a.5.5 0 0 1 0-1M8 3a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 8 3m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/>
      </symbol>
      <symbol id="moon" viewBox="0 0 16 16">
        <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/>
      </symbol>
    </svg>

    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      /**
       * Fase 9 — View Transitions.
       *
       * Con `ClientRouter` el DOM de <body> se reemplaza en cada navegación y
       * los scripts ya ejecutados no se vuelven a correr, así que los listeners
       * se pierden. Todo se registra en `astro:page-load` (que Astro dispara
       * también en la carga inicial) y además se inicializa en el primer render.
       * Cada elemento se marca con `data-astro-init` para no duplicar listeners
       * cuando ambas rutas coinciden en la primera carga.
       */
      const THEME_KEY = 'theme'
      const prefersReducedMotion = () =>
        window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function initTheme() {
        const html = document.documentElement
        const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle')
        const icon = document.querySelector<SVGUseElement>('#themeIcon')

        const updateIcon = (theme: string) => {
          icon?.setAttribute('href', theme === 'dark' ? '#sun' : '#moon')
        }

        // El <use> se recrea en cada navegación: siempre hay que resincronizarlo.
        updateIcon(html.getAttribute('data-theme') ?? 'dark')

        if (!toggle || toggle.dataset.astroInit === 'true') return
        toggle.dataset.astroInit = 'true'
        toggle.addEventListener('click', () => {
          const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark'
          html.setAttribute('data-theme', next)
          try {
            localStorage.setItem(THEME_KEY, next)
          } catch {}
          updateIcon(next)
        })
      }

      /** Reveals al hacer scroll (`data-reveal` / `.reveal` → `is-visible`). */
      function initReveals() {
        const targets = document.querySelectorAll<HTMLElement>(
          '[data-reveal]:not(.is-visible), .reveal:not(.is-visible)'
        )
        if (targets.length === 0) return

        // Sin animación no hay observer: se marcan visibles de inmediato.
        if (prefersReducedMotion()) {
          targets.forEach((el) => el.classList.add('is-visible'))
          return
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        )

        targets.forEach((el) => observer.observe(el))
      }

      /**
       * Video de la taza diferido: el markup se sirve sin `src` y con
       * `preload="none"` (Fase 7, performance), así que los ~246 KB se piden en
       * idle, fuera del camino crítico. Con `prefers-reduced-motion` se carga el
       * primer fotograma pero no se reproduce solo.
       */
      function initDeferredMedia() {
        const videos = document.querySelectorAll<HTMLVideoElement>(
          'video[data-taza-src]:not([data-taza-loaded])'
        )
        videos.forEach((video) => {
          video.dataset.tazaLoaded = 'true'
          const src = video.dataset.tazaSrc
          if (!src) return

          const load = () => {
            if (video.dataset.tazaLoaded === 'loading') return
            video.dataset.tazaLoaded = 'loading'
            video.preload = 'metadata'
            video.src = src
            video.load()
            if (!prefersReducedMotion()) {
              void video.play().catch(() => {})
            }
          }

          // `requestIdleCallback` no está en todos los navegadores (Safari
          // lo añadió tarde): fallback a un timeout prudente.
          const idleWindow = window as Window & {
            requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number
          }
          if (typeof idleWindow.requestIdleCallback === 'function') {
            idleWindow.requestIdleCallback(load, { timeout: 2500 })
          } else {
            window.setTimeout(load, 600)
          }
        })
      }

      function init() {
        initTheme()
        initReveals()
        initDeferredMedia()
      }

      init()
      document.addEventListener('astro:page-load', init)
    </script>
  </body>
</html>
