---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import { getAlternateUrls } from '../i18n/utils'
import { resolveOgImagePath } from '../utils/images'

export interface Props {
  title: string
  description?: string
  lang?: 'es' | 'en'
  image?: string
  type?: 'website' | 'article'
  publishedDate?: Date
}

const { title, description, lang = 'es', image, type = 'website', publishedDate } = Astro.props
const alternates = getAlternateUrls(Astro.url)
const site = (Astro.site?.toString() ?? Astro.url.origin).replace(/\/$/, '')
const canonical = `${site}${Astro.url.pathname}`
const hrefEs = `${site}${alternates.es}`
const hrefEn = `${site}${alternates.en}`
const metaDescription = description ?? title
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US'
const ogLocaleAlternate = lang === 'es' ? 'en_US' : 'es_ES'
// og:image siempre absoluta: variante WebP optimizada de `src/assets/` o ruta pública
const ogImagePath = await resolveOgImagePath(image)
const ogImage = ogImagePath.startsWith('http') ? ogImagePath : `${site}${ogImagePath}`
// Autodiscovery RSS del idioma actual
const rssHref = lang === 'en' ? '/en/rss.xml' : '/rss.xml'
const rssTitle = lang === 'en' ? 'Blog — Teapartydev (EN)' : 'Blog — Teapartydev (ES)'
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={hrefEs} />
    <link rel="alternate" hreflang="en" href={hrefEn} />
    <link rel="alternate" hreflang="x-default" href={hrefEs} />
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href={new URL(rssHref, `${site}/`).toString()} />
    {/* Fase 7 perf fino (sin cambio visual): preload solo de la fuente del
      * camino crítico (Mononoki Regular 400, texto base/FCP) + poster del
      * hero (Avatar.webp 12 KB, LCP diferido). No precargar Bold/MesloLG/
      * NerdFonts: coste de preload injustificado; van con font-display: swap. */}
    <link rel="preload" href="/fonts/Mononoki-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/img/Avatar.webp" as="image" fetchpriority="high" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('theme')
          const theme =
            saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          document.documentElement.setAttribute('data-theme', theme)
        } catch {}
      })()
    </script>
  </head>
  <body class="min-h-screen flex flex-col pt-16">
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
      <symbol id="sun" viewBox="0 0 16 16">
        <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6m0 1a4 4 0 1 0 0-8 4 4 0 0 0 0 8M8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0m0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13m8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5M3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8m10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0m-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0m9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707M4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708"/>
      </symbol>
      <symbol id="moon" viewBox="0 0 16 16">
        <path d="M6 .278a.77.77 0 0 1 .08.858 7.2 7.2 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277q.792-.001 1.533-.16a.79.79 0 0 1 .81.316.73.73 0 0 1-.031.893A8.35 8.35 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.75.75 0 0 1 6 .278"/>
      </symbol>
    </svg>

    <Navbar />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const themeToggle = document.querySelector('.theme-toggle')
      const themeIcon = document.querySelector('#themeIcon')
      const html = document.documentElement

      function updateIcon(theme: string) {
        if (!themeIcon) return
        themeIcon.setAttribute('href', theme === 'dark' ? '#sun' : '#moon')
      }

      updateIcon(html.getAttribute('data-theme') ?? 'dark')

      themeToggle?.addEventListener('click', () => {
        const current = html.getAttribute('data-theme')
        const next = current === 'dark' ? 'light' : 'dark'
        html.setAttribute('data-theme', next)
        try {
          localStorage.setItem('theme', next)
        } catch {}
        updateIcon(next)
      })
    </script>
  </body>
</html>
