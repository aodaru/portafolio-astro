---
import { useTranslations } from '../i18n/utils'
import {
  blogPath,
  blogIndexPath,
  formatDate,
  getLangFromId,
  getSlugFromId,
  tagsIndexPath,
  type Lang,
} from '../i18n/content'
import { resolveImageUrl } from '../utils/images'

export interface Props {
  posts: import('astro:content').CollectionEntry<'blog'>[]
  currentPage: number
  totalPages: number
  lang: Lang
}

const { posts, currentPage, totalPages, lang } = Astro.props
const t = useTranslations(lang)

// Las tarjetas se alimentan de `src/assets/` (WebP optimizado) o de `public/`
// (GIF animados): usar `post.data.image` directo daba 404 para los estáticos.
const postImages = await Promise.all(posts.map((post) => resolveImageUrl(post.data.image, 600)))

function pageUrl(n: number): string {
  const base = blogIndexPath(lang)
  return n === 1 ? base : `${base}/page/${n}`
}

function postUrl(id: string): string {
  return blogPath(getLangFromId(id), getSlugFromId(id))
}

function getPostIcon(title: string): string {
  const t = title.toLowerCase()
  if (t.includes('docker')) return '🐳'
  if (t.includes('terminal') || t.includes('cli')) return '⌨️'
  if (t.includes('post') || t.includes('blog')) return '📝'
  if (t.includes('astro') || t.includes('web')) return '🚀'
  if (t.includes('linux') || t.includes('arch')) return '🐧'
  if (t.includes('git')) return '🔀'
  return '📄'
}
---

<div class="max-w-4xl mx-auto px-4 py-12 animate-fade-in">
  <h1 class="text-3xl font-bold mb-2" style="font-family: 'Mononoki', monospace;">
    <span style="color: var(--gruvbox-green);">$</span>
    <span style="color: var(--gruvbox-yellow); margin-left: 0.5rem;">cat</span> posts.txt
    <span class="terminal-cursor"></span>
  </h1>
  <p class="mb-8 opacity-60" style="font-family: 'MesloLG', monospace; font-size: var(--fs-small);">
    Notas sobre sistemas, desarrollo y cosas que aprendí por el camino.
  </p>

  {posts.length === 0 && (
    <div class="terminal-card">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="terminal-dot close"></span>
          <span class="terminal-dot minimize"></span>
          <span class="terminal-dot maximize"></span>
        </div>
        <span class="terminal-title">adalgarcia@portfolio: ~/blog</span>
      </div>
      <div class="terminal-body">
        <p class="opacity-75">{t('blog.empty')}</p>
      </div>
    </div>
  )}

  {posts.length > 0 && (
    <div class="blog-grid">
      {posts.map((post, i) => (
        <a
          href={postUrl(post.id)}
          class="blog-card stagger-in"
          style={`--reveal-delay: ${i * 0.06}s`}
        >
          <div class="blog-card-image">
            {postImages[i] ? (
              <img
                src={postImages[i]}
                alt={post.data.title}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                width="600"
                height="340"
              />
            ) : (
              <div class="blog-card-icon">{getPostIcon(post.data.title)}</div>
            )}
          </div>
          <div class="blog-card-content">
            <span class="blog-card-date">{formatDate(post.data.date, lang)}</span>
            <h2 class="blog-card-title">{post.data.title}</h2>
            <p class="blog-card-desc">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="blog-card-tags">
                {post.data.tags.map((tag) => (
                  <span class="blog-tag">#{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>
  )}

  {totalPages > 1 && (
    <div class="flex justify-center gap-4 mt-10">
      {currentPage > 1 && (
        <a
          href={pageUrl(currentPage - 1)}
          class="px-4 py-2 rounded border no-underline transition-all duration-300"
          style="border-color: var(--gruvbox-gray); color: var(--gruvbox-fg); font-family: 'MesloLG', monospace;"
        >
          {t('blog.prev')}
        </a>
      )}
      <span class="px-4 py-2 opacity-75" style="font-family: 'MesloLG', monospace;">
        {currentPage} / {totalPages}
      </span>
      {currentPage < totalPages && (
        <a
          href={pageUrl(currentPage + 1)}
          class="px-4 py-2 rounded border no-underline transition-all duration-300"
          style="border-color: var(--gruvbox-gray); color: var(--gruvbox-fg); font-family: 'MesloLG', monospace;"
        >
          {t('blog.next')}
        </a>
      )}
    </div>
  )}

  <div class="mt-8 text-center">
    <a
      href={tagsIndexPath(lang)}
      class="inline-block px-4 py-2 rounded border no-underline transition-all duration-300 hover:border-[var(--gruvbox-yellow)]"
      style="border-color: var(--gruvbox-gray); color: var(--gruvbox-fg); font-family: 'MesloLG', monospace; font-size: var(--fs-small);"
    >
      {t('blog.tags')}
    </a>
  </div>
</div>
