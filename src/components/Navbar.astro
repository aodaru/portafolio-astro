---
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils'
import { languages } from '../i18n/ui'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const translatePath = useTranslatedPath(lang)
const currentPath = Astro.url.pathname

// Sin "Inicio": vive como brand en el markup (icono nf-md-tea).
const links = [
  { href: translatePath('/blog'), label: t('nav.blog'), key: 'blog' },
  { href: translatePath('/trabajos'), label: t('nav.works'), key: 'works' },
  { href: translatePath('/contacto'), label: t('nav.contact'), key: 'contact' },
]

function isActive(href: string): boolean {
  const hrefPath = href.split('?')[0]
  if (hrefPath === '/') {
    return currentPath === '/' || currentPath === ''
  }
  return currentPath.startsWith(hrefPath)
}
---

<header class="main-nav fixed top-0 inset-x-0 z-50">
  <nav class="nav-container">
    <!-- Brand (estilo WP navbar-brand con icono nf-md-tea).
         Sin `aria-label`: el nombre accesible debe coincidir con el texto
         visible (WCAG 2.5.3, auditoría Lighthouse), y el icono ya es decorativo. -->
    <a href={translatePath('/')} class="nav-brand">
      <span class="nf nf-md-tea nav-brand-icon" aria-hidden="true"></span>
      <span class="nav-brand-name">Adal Michael García</span>
    </a>

    <!-- Mobile toggle (estilo WP Bootstrap navbar-toggler) -->
    <button
      class="nav-toggler"
      type="button"
      aria-label={t('nav.menu')}
      aria-expanded="false"
      aria-controls="nav-collapse"
    >
      <span class="nav-toggler-icon">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <!-- Nav collapse (estilo WP navbar-collapse) -->
    <div class="nav-collapse" id="nav-collapse">
      <ul class="nav-list">
        {links.map(({ href, label, key }) => (
          <li class="nav-item">
            <a href={href} class={`nav-link ${isActive(href) ? 'active' : ''}`} aria-label={key === 'home' ? label : undefined}>
              {label}
            </a>
          </li>
        ))}
        <li class="nav-item">
          <a
            href="https://github.com/aodaru"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
            aria-label="GitHub repo"
          >
            <span class="nf nf-fa-github" aria-hidden="true"></span>
            <span class="nav-link-text">{t('nav.repo')}</span>
          </a>
        </li>
      </ul>

      <!-- Selector de idioma (ES | EN) -->
      <div class="lang-switcher">
        {Object.entries(languages).map(([code, name]) => {
          const pathWithoutLang = currentPath.replace(/^\/(es|en)(?=\/|$)/, '') || '/'
          const targetLang = code as keyof typeof languages
          const href = translatePath(pathWithoutLang, targetLang)
          return (
            <a
              href={href}
              hreflang={code}
              class={`nav-link text-xs ${lang === code ? 'lang-active' : 'lang-inactive'}`}
              aria-current={lang === code ? 'true' : undefined}
            >
              {/* El código visible (ES/EN) se oculta al lector: el nombre
               * accesible es el nombre completo, y así no choca con la regla
               * de "el nombre accesible incluye el texto visible". */}
              <span aria-hidden="true">{code.toUpperCase()}</span>
              <span class="sr-only">{name}</span>
            </a>
          )
        })}
      </div>

      <!-- Theme toggle (se mantiene como estaba) -->
      <button class="theme-toggle" aria-label={t('nav.theme')} type="button">
        <svg class="bi" width="24" height="24" fill="currentColor">
          <use href="#sun" id="themeIcon"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  /**
   * Fase 9 — View Transitions: con `ClientRouter` el navbar se reconstruye en
   * cada navegación, así que los listeners se vuelven a enlazar en
   * `astro:page-load`. Los listeners que viven en objetos persistentes
   * (`document`, `matchMedia`) se registran una sola vez vía flags en `<html>`,
   * y consultan el DOM en el momento del evento para no quedar apuntando a
   * nodos desmontados.
   */
  const root = document.documentElement
  const DESKTOP_MQL = '(min-width: 992px)'

  function getNav() {
    const toggler = document.querySelector<HTMLElement>('.nav-toggler')
    const collapse = document.querySelector<HTMLElement>('.nav-collapse')
    return toggler && collapse ? { toggler, collapse } : null
  }

  /**
   * Anima la altura del collapse (estilo Bootstrap collapse).
   * Antes de abrir: `collapsing` con altura actual (0) + overflow hidden
   * Después de abrir: `collapsing` con scrollHeight + transition height 0.35s
   * Al terminar: clase `show`, altura auto, overflow visible
   */
  function toggleCollapse(collapse: HTMLElement) {
    const isOpen = collapse.classList.contains('show')

    if (isOpen) {
      // Cerrar: altura actual → 0
      collapse.style.height = `${collapse.scrollHeight}px`
      // Force reflow
      void collapse.offsetHeight
      collapse.style.height = '0px'
      collapse.style.overflow = 'hidden'
      collapse.classList.remove('show')
      collapse.classList.add('collapsing')
    } else {
      // Abrir: 0 → scrollHeight
      collapse.style.height = '0px'
      collapse.style.overflow = 'hidden'
      collapse.classList.remove('collapse')
      collapse.classList.add('collapsing')
      // Force reflow
      void collapse.offsetHeight
      collapse.style.height = `${collapse.scrollHeight}px`
    }
  }

  function onTransitionEnd(this: HTMLElement, e: TransitionEvent) {
    if (e.propertyName !== 'height') return
    const isOpening = this.style.height !== '0px' && this.style.height !== ''

    this.classList.remove('collapsing')
    this.classList.add('collapse')
    this.classList.remove('show')
    this.style.height = ''
    this.style.overflow = ''
    if (isOpening) this.classList.add('show')
  }

  // Listeners persistentes: una sola vez por sesión del documento.
  if (root.dataset.navDocInit !== 'true') {
    root.dataset.navDocInit = 'true'

    // Cerrar menú al hacer click fuera
    document.addEventListener('click', (e) => {
      const nav = getNav()
      if (!nav) return
      const target = e.target as Node
      if (
        nav.collapse.classList.contains('show') &&
        !nav.collapse.contains(target) &&
        !nav.toggler.contains(target)
      ) {
        nav.toggler.setAttribute('aria-expanded', 'false')
        toggleCollapse(nav.collapse)
      }
    })

    // Cerrar menú al cambiar tamaño a desktop
    window.matchMedia(DESKTOP_MQL).addEventListener('change', () => {
      const nav = getNav()
      if (!nav) return
      if (nav.collapse.classList.contains('show')) {
        nav.collapse.classList.remove('show', 'collapsing')
        nav.collapse.classList.add('collapse')
        nav.collapse.style.height = ''
        nav.collapse.style.overflow = ''
      }
      nav.toggler.setAttribute('aria-expanded', 'false')
    })
  }

  function initNav() {
    const nav = getNav()
    if (!nav || nav.toggler.dataset.astroInit === 'true') return
    nav.toggler.dataset.astroInit = 'true'

    nav.collapse.addEventListener('transitionend', onTransitionEnd)
    nav.toggler.addEventListener('click', () => {
      const expanded = nav.toggler.getAttribute('aria-expanded') === 'true'
      nav.toggler.setAttribute('aria-expanded', String(!expanded))
      toggleCollapse(nav.collapse)
    })
  }

  initNav()
  document.addEventListener('astro:page-load', initNav)
</script>
