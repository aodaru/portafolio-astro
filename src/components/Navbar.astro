---
const currentPath = Astro.url.pathname

const links = [
//  { href: '/', label: 'Inicio' },
  { href: '/blog', label: 'Blog' },
  { href: '/trabajos', label: 'Trabajos' },
  { href: '/contacto', label: 'Contacto' },
]
---

<header class="main-nav fixed top-0 inset-x-0 z-50">
  <nav class="nav-container">
    <!-- Brand (estilo WP navbar-brand con icono nf-md-tea) -->
    <a href="/" class="nav-brand" aria-label="Inicio">
      <span class="nf nf-md-tea nav-brand-icon" aria-hidden="true"></span>
      <span class="nav-brand-name">Adal Michael García</span>
    </a>

    <!-- Mobile toggle (estilo WP Bootstrap navbar-toggler) -->
    <button
      class="nav-toggler"
      type="button"
      aria-label="Menú de navegación"
      aria-expanded="false"
      aria-controls="nav-collapse"
    >
      <span class="nav-toggler-icon">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <!-- Nav collapse (estilo WP navbar-collapse) -->
    <div class="nav-collapse" id="nav-collapse">
      <ul class="nav-list">
        {links.map(({ href, label }) => (
          <li class="nav-item">
            <a href={href} class={`nav-link ${currentPath === href ? 'active' : ''}`}>
              {label}
            </a>
          </li>
        ))}
        <li class="nav-item">
          <a
            href="https://github.com/aodaru"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
            aria-label="GitHub repo"
          >
            <span class="nf nf-fa-github" aria-hidden="true"></span>
            <span class="nav-link-text">repo</span>
          </a>
        </li>
      </ul>

      <!-- Theme toggle (se mantiene como estaba) -->
      <button class="theme-toggle" aria-label="Cambiar tema" type="button">
        <svg class="bi" width="24" height="24" fill="currentColor">
          <use href="#sun" id="themeIcon"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggler = document.querySelector<HTMLElement>('.nav-toggler')
  const collapse = document.querySelector<HTMLElement>('.nav-collapse')

  /**
   * Anima la altura del collapse (estilo Bootstrap collapse).
   * Antes de abrir: `collapsing` con altura actual (0) + overflow hidden
   * Después de abrir: `collapsing` con scrollHeight + transition height 0.35s
   * Al terminar: clase `show`, altura auto, overflow visible
   */
  function toggleCollapse() {
    if (!collapse) return
    const isOpen = collapse.classList.contains('show')

    if (isOpen) {
      // Cerrar: altura actual → 0
      collapse.style.height = `${collapse.scrollHeight}px`
      // Force reflow
      void collapse.offsetHeight
      collapse.style.height = '0px'
      collapse.style.overflow = 'hidden'
      collapse.classList.remove('show')
      collapse.classList.add('collapsing')
    } else {
      // Abrir: 0 → scrollHeight
      collapse.style.height = '0px'
      collapse.style.overflow = 'hidden'
      collapse.classList.remove('collapse')
      collapse.classList.add('collapsing')
      // Force reflow
      void collapse.offsetHeight
      collapse.style.height = `${collapse.scrollHeight}px`
    }
  }

  function onTransitionEnd(this: HTMLElement, e: TransitionEvent) {
    if (e.propertyName !== 'height') return
    const isOpening = this.style.height !== '0px' && this.style.height !== ''

    this.classList.remove('collapsing')
    this.classList.add('collapse')
    if (isOpening) {
      this.classList.add('show')
      this.style.height = ''
      this.style.overflow = ''
    } else {
      this.classList.remove('show')
      this.style.height = ''
      this.style.overflow = ''
    }
  }

  collapse?.addEventListener('transitionend', onTransitionEnd)

  toggler?.addEventListener('click', () => {
    const expanded = toggler.getAttribute('aria-expanded') === 'true'
    toggler.setAttribute('aria-expanded', String(!expanded))
    toggleCollapse()
  })

  // Cerrar menú al hacer click fuera
  document.addEventListener('click', (e) => {
    const target = e.target as Node
    if (
      collapse?.classList.contains('show') &&
      !collapse.contains(target) &&
      !toggler?.contains(target)
    ) {
      toggler?.setAttribute('aria-expanded', 'false')
      toggleCollapse()
    }
  })

  // Cerrar menú al cambiar tamaño a desktop
  const mql = window.matchMedia('(min-width: 992px)')
  mql.addEventListener('change', () => {
    if (collapse?.classList.contains('show')) {
      collapse.classList.remove('show', 'collapsing')
      collapse.classList.add('collapse')
      collapse.style.height = ''
      collapse.style.overflow = ''
    }
    toggler?.setAttribute('aria-expanded', 'false')
  })
</script>
