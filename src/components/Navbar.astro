---
const currentPath = Astro.url.pathname

const links = [
  { href: '/', label: 'Inicio', icon: true },
  { href: '/blog', label: 'Blog' },
  { href: '/trabajos', label: 'Trabajos' },
  { href: '/contacto', label: 'Contacto' },
]
---

<header class="gruvbox-nav fixed top-0 inset-x-0 z-50">
  <nav class="nav-container">
    <!-- Brand -->
    <a href="/" class="nav-brand" aria-label="Inicio">
      <span class="nf nf-md-tea nav-brand-icon" aria-hidden="true"></span>
      <span class="nav-brand-name">Adal Michael García</span>
    </a>

    <!-- Mobile toggle (estilo WP Bootstrap) -->
    <button
      class="nav-toggler"
      type="button"
      aria-label="Menú de navegación"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span class="nav-toggler-icon">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>

    <!-- Menu -->
    <div class="nav-menu" id="nav-menu">
      <ul class="nav-list">
        {links.map(({ href, label, icon }) => (
          <li class="nav-item">
            <a href={href} class={`nav-link ${currentPath === href ? 'active' : ''}`}>
              {icon ? <span class="nf nf-md-tea" aria-hidden="true"></span> : label}
            </a>
          </li>
        ))}
        <li class="nav-item">
          <a
            href="https://github.com/aodaru"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-link"
            aria-label="GitHub repo"
          >
            <span class="nf nf-fa-github" aria-hidden="true"></span>
            <span class="nav-link-text">repo</span>
          </a>
        </li>
      </ul>

      <!-- Theme toggle (se mantiene como estaba) -->
      <button class="theme-toggle" aria-label="Cambiar tema" type="button">
        <svg class="bi" width="24" height="24" fill="currentColor">
          <use href="#sun" id="themeIcon"/>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggler = document.querySelector('.nav-toggler')
  const menu = document.querySelector('.nav-menu')
  const nav = document.querySelector('.gruvbox-nav')

  toggler?.addEventListener('click', () => {
    const expanded = toggler.getAttribute('aria-expanded') === 'true'
    toggler.setAttribute('aria-expanded', String(!expanded))
    menu?.classList.toggle('is-open')
  })

  // Cerrar menú al hacer click fuera
  document.addEventListener('click', (e) => {
    if (!menu?.contains(e.target as Node) && !toggler?.contains(e.target as Node)) {
      menu?.classList.remove('is-open')
      toggler?.setAttribute('aria-expanded', 'false')
    }
  })

  // Cerrar menú al cambiar tamaño a desktop
  const mql = window.matchMedia('(min-width: 768px)')
  mql.addEventListener('change', () => {
    menu?.classList.remove('is-open')
    toggler?.setAttribute('aria-expanded', 'false')
  })

  // Glass effect on scroll (estilo WP): navbar gana opacidad al bajar
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (nav && !reducedMotion) {
    const onScroll = () => {
      if (window.scrollY > 20) {
        nav.classList.add('is-scrolled')
      } else {
        nav.classList.remove('is-scrolled')
      }
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
  }
</script>
