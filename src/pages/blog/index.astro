---
import BaseLayout from '../../layouts/BaseLayout.astro'
import BlogPostList from '../../components/BlogPostList.astro'
import { getCollection } from 'astro:content'
import { getLangFromUrl, useTranslations } from '../../i18n/utils'

const allPosts = await getCollection('blog')
const publishedPosts = allPosts
  .filter((post) => !post.data.draft && post.data.lang === 'es')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const pageSize = 5
const totalPages = Math.max(1, Math.ceil(publishedPosts.length / pageSize))
const currentPage = 1
const posts = publishedPosts.slice(0, pageSize)
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<BaseLayout
  title={t('blog.title')}
  description={t('blog.description')}
  lang={lang}
>
  <BlogPostList lang={lang} posts={posts} currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
