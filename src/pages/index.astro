---
import BaseLayout from '../layouts/BaseLayout.astro'
import TazaAscii from '../components/TazaAscii.astro'
import bio from '../data/bio.json'
import '../styles/pages/home.css'
---

<BaseLayout title="Teapartydev — Inicio" description="Portafolio personal de Adal Michael García">
  <div class="inicio8">
    <section class="hero8">
      <div class="hero8-bg" aria-hidden="true">
        <video autoplay muted loop playsinline class="hero8-video" data-taza-play>
          <source src="/img/taza-cafe-compressed.webm" type="video/webm" />
        </video>
        <div class="hero8-overlay"></div>
      </div>

      <div class="hero8-grid">
        <div class="hero8-text">
          <div class="hero8-eyebrow">— Hello, I'm a {bio.role} based in Panamá</div>

          <h1 class="hero8-title">
            <span class="hero8-line">Adal</span>
            <span class="hero8-line hero8-line-accent">Michael</span>
            <span class="hero8-line">García</span>
          </h1>

          <p class="hero8-sub">
            I build <em>digital systems</em> that respect the operator.
            Reporting tools, data layers, and the kind of small software
            that makes teams faster.
          </p>

          <div class="hero8-cta">
            <a href="/trabajos" class="hero8-btn hero8-btn-primary">
              View my work
              <span class="hero8-btn-arrow">→</span>
            </a>
            <a href="/contacto" class="hero8-btn hero8-btn-ghost">Get in touch</a>
          </div>

          <div class="hero8-meta">
            <span><span class="hero8-meta-key">role</span> engineer / sysadmin</span>
            <span><span class="hero8-meta-key">since</span> 2012</span>
            <span><span class="hero8-meta-key">based</span> Chiriquí, PA</span>
          </div>
        </div>

        <aside class="hero8-taza-wrap">
          <TazaAscii variant="svg" size="lg" label="Taza de café humeante" class="hero8-taza" />
          <div class="hero8-taza-caption">
            <span class="hero8-cup-icon">☕</span>
            <span>currently brewing</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="sec8" data-reveal>
      <div class="sec8-label">— 01 / About</div>
      <div class="sec8-content">
        <h2 class="sec8-h2">A decade of keeping things running.</h2>
        <p class="sec8-p">
          I've spent the last 12+ years in the trenches of system administration — building
          reporting tools, data query layers, and small pieces of software that make teams
          faster. I care about reliability, clarity, and tools that respect the operator.
        </p>
        <a href="/blog" class="sec8-link">Read my notes →</a>
      </div>
    </section>

    <section class="sec8" data-reveal>
      <div class="sec8-label">— 02 / Selected work</div>
      <div class="sec8-content">
        <h2 class="sec8-h2">Recent projects</h2>
        <p class="sec8-p sec8-p-sm">A few things I've built and shipped recently.</p>

        <div class="proj8-grid">
          <a href="/trabajos" class="proj8-card">
            <span class="proj8-num">01</span>
            <h3 class="proj8-title">Intranet & reporting</h3>
            <p class="proj8-desc">Sales reporting, dashboards, and internal tools for fast decision-making.</p>
            <span class="proj8-arrow">→</span>
          </a>

          <a href="/trabajos" class="proj8-card">
            <span class="proj8-num">02</span>
            <h3 class="proj8-title">Web platforms</h3>
            <p class="proj8-desc">Custom websites and content systems tailored to small business needs.</p>
            <span class="proj8-arrow">→</span>
          </a>

          <a href="/trabajos" class="proj8-card">
            <span class="proj8-num">03</span>
            <h3 class="proj8-title">This portfolio</h3>
            <p class="proj8-desc">A static site built with Astro + GruvBox, replacing a WordPress theme.</p>
            <span class="proj8-arrow">→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="sec8" data-reveal>
      <div class="sec8-label">— 03 / Things I like</div>
      <div class="sec8-content">
        <h2 class="sec8-h2">Beyond the terminal</h2>
        <p class="sec8-p">
          When I'm not shipping code, you'll find me tinkering with electronics, IoT projects,
          and way too many video games.
        </p>
        <div class="hobby8-grid">
          {bio.hobbies.map((hobby) => (
            <span class="hobby8-chip">{hobby}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="sec8 sec8-cta" data-reveal>
      <div class="cta8">
        <h2 class="cta8-h2">Have something in mind?</h2>
        <p class="cta8-p">Let's talk about systems, tools, or a new project.</p>
        <div class="cta8-actions">
          <a href="mailto:hi@teapartydev.com" class="hero8-btn hero8-btn-primary">
            Say hello
            <span class="hero8-btn-arrow">→</span>
          </a>
          <div class="cta8-socials">
            <a href="https://github.com/aodaru" target="_blank" rel="noopener noreferrer" class="cta8-social">GitHub</a>
            <a href="https://twitter.com/aodaru" target="_blank" rel="noopener noreferrer" class="cta8-social">Twitter</a>
            <a href="https://www.linkedin.com/in/adal-garcia-471889197/" target="_blank" rel="noopener noreferrer" class="cta8-social">LinkedIn</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -80px 0px' }
  );

  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
